# Settings of the gluetun-cyberghost container. Copy to vpn.env and adapt.
# Read when the container starts: restart it after a change.
# Format: NAME=value, WITHOUT quotes, even with spaces (Podman would keep the
# quotes in the value). An empty value means the setting is not used.

# --- CyberGhost server (cyberghost-wg) ---
# Country, 2-letter code (CH, DE, NL, US...).
CG_COUNTRY=CH
# Server type: torrent, all, gaming or nospy (Bucharest; CG_COUNTRY is ignored).
CG_TYPE=torrent
# Optional: only the servers of this city (e.g. zurich, new york).
CG_CITY=
# Optional: the servers of a streaming service (e.g. BBC iPlayer); replaces CG_TYPE.
CG_SERVICE=
# Optional: this server (e.g. zurich-s404-i06) instead of the least loaded one.
# Fails once CyberGhost removes it from its list.
CG_INSTANCE=
# Name of the device in the CyberGhost account, used on the first start only.
CG_DEVICE_NAME=gluetun

# --- Credentials ---
# Recommended: the secrets cg_username and cg_password (see README.md), and
# nothing here. Possible but not advised: the account here, in clear text and
# shown by `docker inspect` / `podman inspect` (keep this file mode 0600).
# CG_USERNAME=
# CG_PASSWORD=

# --- gluetun ---
# Time zone of the logs.
TZ=Europe/Paris
# Apart from the DNS, the values below are gluetun's defaults; every setting is
# described in its wiki: https://github.com/qdm12/gluetun-wiki
# DNS resolvers, over TLS through the tunnel: quad9, cloudflare, google, mullvad...
# Quad9 validates DNSSEC and blocks malicious domains (gluetun's default: cloudflare).
# Several: comma-separated.
DNS_UPSTREAM_RESOLVERS=quad9
# DNS blocking: malicious domains, ads, trackers (on / off).
BLOCK_MALICIOUS=on
BLOCK_ADS=off
BLOCK_SURVEILLANCE=off
# Local networks reachable outside the tunnel from gluetun and the containers
# sharing its network (e.g. 192.168.1.0/24 for a NAS). Empty: nothing outside.
FIREWALL_OUTBOUND_SUBNETS=
# Packet size in the tunnel; lower it if some sites do not load.
WIREGUARD_MTU=1320
# Log level: debug, info, warning, error.
LOG_LEVEL=info
